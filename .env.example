# =============================================================================
# Environment variable reference
# =============================================================================
#
# VARIABLE NAMES ONLY. Never put a real value in this file — it is committed.
#
#   - Local development: copy to `.env` (git-ignored) and fill in local values.
#   - Staging/production: inject through secret management. Do not deploy a
#     `.env` file.
#
# See SECURITY.md for how secrets are handled.
# =============================================================================


# -----------------------------------------------------------------------------
# Phase 2 — required today. The app validates these at boot and refuses to
# start if any is missing or malformed.
# -----------------------------------------------------------------------------

# One of: development | test | staging | production
NODE_ENV=development

# Port the HTTP server binds to.
PORT=3000

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Human-readable log output. Local development only — deployed environments
# must emit JSON so logs stay parseable by the aggregator.
LOG_PRETTY=false

# Comma-separated browser origins allowed to call the API.
# Leave empty to allow none, which is correct for a mobile-app-only deployment.
CORS_ALLOWED_ORIGINS=

# Rate limiting: max requests per client per window.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Serves the OpenAPI explorer at /api/docs. Keep false in production.
SWAGGER_ENABLED=false

# Number of reverse proxies in front of the app. Must match the deployment or
# client IPs — and therefore rate limiting and audit logs — will be wrong.
TRUSTED_PROXY_HOPS=0

# Maximum accepted request body size.
BODY_LIMIT=1mb


# -----------------------------------------------------------------------------
# Phase 4 — authentication. Required today.
# -----------------------------------------------------------------------------

# Signing key for access tokens. REQUIRED, minimum 32 characters, and no
# default — a predictable key lets anyone mint a token for any account.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Access token lifetime in seconds (60-3600). Short by design.
JWT_ACCESS_TTL_SECONDS=900

# Refresh token lifetime in days. Rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30

# One-time passcode behaviour.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# Demo-only override: pins every issued OTP to this value so a live demo
# audience without a phone can still log in. Must be all digits and its length
# must equal OTP_LENGTH. REFUSED at boot when NODE_ENV=production. Leave unset
# in any environment that must issue real, random codes.
# OTP_DEMO_FIXED_CODE=123456

# SMS provider for OTP delivery and notifications. `mock` records delivery
# metadata only and sends nothing. Real providers are contracted later — do not
# invent values.
SMS_PROVIDER=mock

# Push-notification provider (Phase 16). `mock` logs delivery metadata only.
# A real provider (e.g. FCM/APNs) is added when contracted — never invent creds.
PUSH_PROVIDER=mock


# -----------------------------------------------------------------------------
# Phase 7 — pricing and VAT. Required today.
# -----------------------------------------------------------------------------

# Standard VAT rate as a decimal fraction. 0.15 = 15%, the current Saudi
# standard rate, confirmed for this platform.
#
# Configurable because a statutory rate can change. When it does, only NEW
# orders are affected: every order and invoice line snapshots the rate it was
# charged at, so history is never rewritten.
VAT_STANDARD_RATE=0.15

# Whether catalog prices already include VAT.
#
# true for Saudi consumer pricing — a menu price of 32.50 SAR already contains
# its tax, and the engine backs the tax out rather than adding to it.
# REQUIRES ACCOUNTANT CONFIRMATION before production.
PRICES_INCLUDE_VAT=true

# Whether the delivery fee is part of the taxable supply.
# REQUIRES ACCOUNTANT CONFIRMATION before production.
DELIVERY_FEE_TAXABLE=true

# --- Phase 17: loyalty -------------------------------------------------------
# Loyalty points earned per whole SAR of an order's total. The earn rate is a
# business decision — this default of 1 is a placeholder and must be confirmed
# with the owner before launch. Set to 0 to disable earning.
LOYALTY_POINTS_PER_SAR=1

# --- Phase 14: delivery dispatch ---------------------------------------------
# The most deliveries one driver may be carrying at once.
#
# A busy driver can be given another drop — batching two or three onto one run
# is how a small fleet works. This is the CEILING on that, not a policy about
# it: how many a driver should carry depends on the vehicle, the bag and the
# distances, which is the owner's call. The default is a safety limit so a
# mis-click cannot put a dozen orders on one motorcycle — CONFIRM THE REAL
# NUMBER WITH THE OWNER before launch, like the VAT rate and the earn rate.
# Set to 1 to restore one-job-at-a-time assignment.
DRIVER_MAX_ACTIVE_DELIVERIES=3

# --- Phase 12: refund requests -----------------------------------------------
# TWO WINDOWS, because they answer two different questions on two clocks.
# OWNER DECISION (2026-09-08): 10 minutes for both.
#
# How long after PLACING an order a customer may ask to cancel it.
# A cancellation is "I've changed my mind", and the cost of a late change lands
# on the kitchen — so this runs from placement, not from the branch accepting
# (which would give a slow branch's customers longer than a fast one's).
REFUND_CANCELLATION_WINDOW_MINUTES=10

# How long after DELIVERY a customer may ask for a refund.
# A refund is "something was wrong with what arrived", which cannot be known
# until it arrives, so it runs on its own clock. Minutes rather than hours
# because that is the unit the answer came in.
#
# Clearing either variable means no deadline on that ask.
REFUND_REQUEST_WINDOW_MINUTES=10

# --- Phase 11: payments ------------------------------------------------------
# Which gateway adapter to use. `mock` is a fully working sandbox gateway used
# for development and tests; `tap` selects the real adapter, which is an explicit
# stub until official Tap documentation and merchant credentials exist. Never
# set this to `tap` before that adapter is implemented.
PAYMENT_GATEWAY=mock
# Sandbox rails, and the mock gateway's simulate endpoint. That endpoint is
# public and marks an order PAID, so this defaults to false and is REFUSED at
# boot when NODE_ENV=production — as is PAYMENT_GATEWAY=mock. Set it to true
# only for local development and the demo. Sandbox and production gateway
# credentials are strictly separated.
PAYMENT_SANDBOX=true
# HMAC secret the mock gateway signs and verifies its webhooks with. A dev value
# only — the mock never touches real money. Replace in any shared environment.
PAYMENT_MOCK_WEBHOOK_SECRET=mock-dev-webhook-secret-change-me
# Sandbox only: the mock gateway settles its own charges by delivering a
# correctly signed success webhook to the ordinary ingestion path. Without it
# nothing ever completes an online payment — there is no hosted page and no bank
# behind the mock — so every online order sits in PENDING_PAYMENT for ever and
# never reaches the branch. Off by default; the demo turns it on. Ignored unless
# PAYMENT_SANDBOX=true and PAYMENT_GATEWAY=mock, both refused in production.
PAYMENT_MOCK_AUTO_SETTLE=true


# =============================================================================
# LATER PHASES — listed for planning only.
#
# These are NOT read by the application yet. Each is added to environment
# validation by the phase that actually consumes it. Do not populate them in
# advance, and never invent a credential: where a real one is unavailable,
# the corresponding module ships a mock adapter instead (see AGENT rules in
# the master specification, section 27).
# =============================================================================

# --- Phase 11: real Tap adapter (not yet implemented) ------------------------
# The gateway interface and a working mock adapter exist (see the active
# PAYMENT_* vars above). These Tap credentials are consumed only once the Tap
# adapter itself is built, from official Tap documentation. Sandbox and
# production credentials are kept strictly separate and never shared with any
# client app. Do not populate in advance; they arrive through secret management.
# TAP_API_BASE_URL=
# TAP_SECRET_KEY=
# TAP_PUBLISHABLE_KEY=
# TAP_MERCHANT_ID=
# TAP_WEBHOOK_SECRET=

# --- Phase 13: ZATCA e-invoicing ---------------------------------------------
# Values depend on the restaurant's applicable phase/wave and must come from
# official ZATCA onboarding — never guessed.
# ZATCA_ENVIRONMENT=
# ZATCA_API_BASE_URL=
# ZATCA_VAT_NUMBER=
# ZATCA_CR_NUMBER=
# ZATCA_SELLER_NAME=
# ZATCA_CSR_COMMON_NAME=
# Certificates and private keys are mounted from secret storage, never set as
# plain environment variables and never committed:
# ZATCA_CERTIFICATE_PATH=
# ZATCA_PRIVATE_KEY_PATH=

# --- Phase 16: notifications -------------------------------------------------
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=
# PUSH_PROVIDER=
# PUSH_CREDENTIALS_PATH=

# --- Phase 14: maps / delivery ----------------------------------------------
# MAPS_PROVIDER=
# MAPS_API_KEY=

# --- File / object storage ---------------------------------------------------
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
